global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  # Studio (always-on Mac Studio M3 Ultra, primary inference + monitoring hub)
  - job_name: "studio"
    static_configs:
      - targets: ["localhost:9199"]
        labels:
          host: "studio"

  # node_exporter — Studio
  - job_name: "node-studio"
    static_configs:
      - targets: ["localhost:9100"]
        labels:
          host: "studio"

  # node_exporter — Synology NAS (tanker)
  - job_name: "node-tanker"
    static_configs:
      - targets: ["100.102.22.38:9100"]
        labels:
          host: "tanker"

  # Splash — Studio Metal inference engine (standalone; NOT served by llama-swap).
  # Splash natively exposes /metrics: readiness, memory residency, decode/prefill
  # t/s, draft acceptance, KV pages, TTFT/ITL histograms. Two instances:
  # :8100 ms-qwen3.8-27b-swift1.5, :8102 ms-qwen3.6-35b-a3b. Both bind the
  # tailnet IP (100.89.133.43) — localhost will NOT answer.
  - job_name: "splash-studio"
    static_configs:
      - targets: ["100.89.133.43:8100"]
        labels:
          host: "studio"
  - job_name: "splash-studio-35b"
    static_configs:
      - targets: ["100.89.133.43:8102"]
        labels:
          host: "studio"

  # blackbox_exporter — HTTP probes for local services
  - job_name: "blackbox-http"
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
          - "http://localhost:3001"      # Grafana
          - "http://localhost:9090"      # Prometheus self
          - "http://localhost:9100"      # node_exporter Studio
          - "http://localhost:9115"      # blackbox self
        labels:
          host: "studio"
      - targets:
          - "http://100.102.22.38:9100"  # node_exporter tanker
        labels:
          host: "tanker"
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: localhost:9115
