{
  "_comment": "Wan 2.2 text-to-video, two-stage (high_noise + low_noise), GGUF Q5_K_M + 4-step lightx2v LoRAs on Mac Studio. Models: wan2.2_t2v_high_noise_14B_Q5_K_M.gguf + wan2.2_t2v_low_noise_14B_Q5_K_M.gguf (diffusion_models/), umt5-xxl-encoder-Q8_0.gguf (text_encoders/, type wan), wan_2.1_vae.safetensors (vae/ — the 16-channel VAE; the wan2.2_vae.safetensors file is a 48-channel VAE and will NOT decode this model). LoRAs: wan2.2_t2v_lightx2v_4steps_lora_v1.1_high_noise + _low_noise (loras/, strength 1.0). 4-step config: stage1 high-noise 0..2, stage2 low-noise 2..4. Output: MP4 via SaveVideo. ~7-8x faster than 30-step.",
  "1": {
    "class_type": "UnetLoaderGGUF",
    "_meta": {"title": "Wan 2.2 High Noise UNet"},
    "inputs": {"unet_name": "wan2.2_t2v_high_noise_14B_Q5_K_M.gguf"}
  },
  "2": {
    "class_type": "UnetLoaderGGUF",
    "_meta": {"title": "Wan 2.2 Low Noise UNet"},
    "inputs": {"unet_name": "wan2.2_t2v_low_noise_14B_Q5_K_M.gguf"}
  },
  "3": {
    "class_type": "CLIPLoaderGGUF",
    "_meta": {"title": "Wan Text Encoder (umt5)"},
    "inputs": {"clip_name": "umt5-xxl-encoder-Q8_0.gguf", "type": "wan"}
  },
  "4": {
    "class_type": "VAELoader",
    "_meta": {"title": "Wan VAE"},
    "inputs": {"vae_name": "wan_2.1_vae.safetensors"}
  },
  "15": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": {"title": "High Noise 4-step LoRA"},
    "inputs": {"model": ["1", 0], "lora_name": "wan2.2_t2v_lightx2v_4steps_lora_v1.1_high_noise.safetensors", "strength_model": 1.0}
  },
  "16": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": {"title": "Low Noise 4-step LoRA"},
    "inputs": {"model": ["2", 0], "lora_name": "wan2.2_t2v_lightx2v_4steps_lora_v1.1_low_noise.safetensors", "strength_model": 1.0}
  },
  "5": {
    "class_type": "ModelSamplingSD3",
    "_meta": {"title": "High Noise Sampling"},
    "inputs": {"model": ["15", 0], "shift": 5.0}
  },
  "6": {
    "class_type": "ModelSamplingSD3",
    "_meta": {"title": "Low Noise Sampling"},
    "inputs": {"model": ["16", 0], "shift": 5.0}
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Positive Prompt"},
    "inputs": {"text": "a graceful crane taking flight from a misty lake at dawn, slow motion, cinematic", "clip": ["3", 0]}
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Negative Prompt"},
    "inputs": {"text": "static, blurry, watermark, low quality, distorted, deformed, extra limbs, bad anatomy", "clip": ["3", 0]}
  },
  "9": {
    "class_type": "EmptyHunyuanLatentVideo",
    "_meta": {"title": "Latent Video (frames)"},
    "inputs": {"width": 832, "height": 480, "length": 33, "batch_size": 1}
  },
  "10": {
    "class_type": "KSamplerAdvanced",
    "_meta": {"title": "Stage 1 — High Noise (0..2)"},
    "inputs": {
      "model": ["5", 0],
      "positive": ["7", 0],
      "negative": ["8", 0],
      "latent_image": ["9", 0],
      "add_noise": "enable",
      "noise_seed": 42,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "start_at_step": 0,
      "end_at_step": 2,
      "return_with_leftover_noise": "enable"
    }
  },
  "11": {
    "class_type": "KSamplerAdvanced",
    "_meta": {"title": "Stage 2 — Low Noise (2..4)"},
    "inputs": {
      "model": ["6", 0],
      "positive": ["7", 0],
      "negative": ["8", 0],
      "latent_image": ["10", 0],
      "add_noise": "disable",
      "noise_seed": 42,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "start_at_step": 2,
      "end_at_step": 4,
      "return_with_leftover_noise": "disable"
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "_meta": {"title": "VAE Decode"},
    "inputs": {"samples": ["11", 0], "vae": ["4", 0]}
  },
  "13": {
    "class_type": "CreateVideo",
    "_meta": {"title": "Create Video"},
    "inputs": {"images": ["12", 0], "fps": 16.0}
  },
  "14": {
    "class_type": "SaveVideo",
    "_meta": {"title": "Save Video"},
    "inputs": {
      "video": ["13", 0],
      "filename_prefix": "wan_t2v",
      "format": "mp4"
    }
  }
}
