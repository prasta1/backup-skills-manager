{
  "_comment": "Wan 2.2 IMAGE-to-video, two-stage (high_noise + low_noise), GGUF Q5_K_M + 4-step lightx2v LoRAs, Mac Studio. Same family as wan22_t2v_gguf.json but with WanImageToVideo driving the latent from a LoadImage start frame. Models: wan2.2_i2v_high_noise_14B_Q5_K_M.gguf + wan2.2_i2v_low_noise_14B_Q5_K_M.gguf (diffusion_models/), umt5-xxl-encoder-Q8_0.gguf (text_encoders/, type wan), wan_2.1_vae.safetensors (vae/ - the 16-channel VAE; wan2.2_vae.safetensors is 48-channel and will NOT decode this model). LoRAs: wan2.2_i2v_lightx2v_4steps_lora_v1_{high,low}_noise (loras/, strength 1.0). 4-step config: stage1 0..2, stage2 2..4. Output MP4 via SaveVideo. Start image must live in ComfyUI/input/.",
  "1": {
    "class_type": "UnetLoaderGGUF",
    "_meta": { "title": "Wan 2.2 I2V High Noise UNet" },
    "inputs": { "unet_name": "wan2.2_i2v_high_noise_14B_Q5_K_M.gguf" }
  },
  "2": {
    "class_type": "UnetLoaderGGUF",
    "_meta": { "title": "Wan 2.2 I2V Low Noise UNet" },
    "inputs": { "unet_name": "wan2.2_i2v_low_noise_14B_Q5_K_M.gguf" }
  },
  "3": {
    "class_type": "CLIPLoaderGGUF",
    "_meta": { "title": "Wan Text Encoder (umt5)" },
    "inputs": { "clip_name": "umt5-xxl-encoder-Q8_0.gguf", "type": "wan" }
  },
  "4": {
    "class_type": "VAELoader",
    "_meta": { "title": "Wan VAE (16-channel)" },
    "inputs": { "vae_name": "wan_2.1_vae.safetensors" }
  },
  "15": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": { "title": "High Noise 4-step LoRA" },
    "inputs": {
      "model": ["1", 0],
      "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_high_noise.safetensors",
      "strength_model": 1.0
    }
  },
  "16": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": { "title": "Low Noise 4-step LoRA" },
    "inputs": {
      "model": ["2", 0],
      "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_low_noise.safetensors",
      "strength_model": 1.0
    }
  },
  "5": {
    "class_type": "ModelSamplingSD3",
    "_meta": { "title": "High Noise Sampling" },
    "inputs": { "model": ["15", 0], "shift": 5.0 }
  },
  "6": {
    "class_type": "ModelSamplingSD3",
    "_meta": { "title": "Low Noise Sampling" },
    "inputs": { "model": ["16", 0], "shift": 5.0 }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive Prompt (describe the MOTION)" },
    "inputs": {
      "text": "slow cinematic push-in on the still life, dust motes drifting through the beam of light, a faint glint travelling across the polished surface, shallow depth of field, locked camera, smooth stabilised motion",
      "clip": ["3", 0]
    }
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative Prompt" },
    "inputs": {
      "text": "static, blurry, watermark, low quality, distorted, deformed, extra limbs, bad anatomy, jitter, warping, morphing, flicker",
      "clip": ["3", 0]
    }
  },
  "17": {
    "class_type": "LoadImage",
    "_meta": { "title": "Start Frame" },
    "inputs": { "image": "i2v_test_still.png" }
  },
  "18": {
    "class_type": "WanImageToVideo",
    "_meta": { "title": "Image to Video (start frame -> latent)" },
    "inputs": {
      "positive": ["7", 0],
      "negative": ["8", 0],
      "vae": ["4", 0],
      "start_image": ["17", 0],
      "width": 640,
      "height": 640,
      "length": 33,
      "batch_size": 1
    }
  },
  "10": {
    "class_type": "KSamplerAdvanced",
    "_meta": { "title": "Stage 1 - High Noise (0..2)" },
    "inputs": {
      "model": ["5", 0],
      "positive": ["18", 0],
      "negative": ["18", 1],
      "latent_image": ["18", 2],
      "add_noise": "enable",
      "noise_seed": 42,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "start_at_step": 0,
      "end_at_step": 2,
      "return_with_leftover_noise": "enable"
    }
  },
  "11": {
    "class_type": "KSamplerAdvanced",
    "_meta": { "title": "Stage 2 - Low Noise (2..4)" },
    "inputs": {
      "model": ["6", 0],
      "positive": ["18", 0],
      "negative": ["18", 1],
      "latent_image": ["10", 0],
      "add_noise": "disable",
      "noise_seed": 42,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "start_at_step": 2,
      "end_at_step": 4,
      "return_with_leftover_noise": "disable"
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" },
    "inputs": { "samples": ["11", 0], "vae": ["4", 0] }
  },
  "13": {
    "class_type": "CreateVideo",
    "_meta": { "title": "Create Video" },
    "inputs": { "images": ["12", 0], "fps": 16.0 }
  },
  "14": {
    "class_type": "SaveVideo",
    "_meta": { "title": "Save Video" },
    "inputs": {
      "video": ["13", 0],
      "filename_prefix": "wan_i2v",
      "format": "mp4"
    }
  }
}
